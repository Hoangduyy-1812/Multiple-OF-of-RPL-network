      <mote>0</mote>
      <mote>1</mote>
      <mote>2</mote>
      <mote>3</mote>
      <mote>4</mote>
      <showRadioRXTX />
      <showRadioHW />
      <showLEDs />
      <zoomfactor>500.0</zoomfactor>
    </plugin_config>
    <width>1315</width>
    <z>4</z>
    <height>166</height>
    <location_x>0</location_x>
    <location_y>479</location_y>
  </plugin>
  <plugin>
